# =====================================================================
# RESTAURANTE RYU - PLANTILLA DE VARIABLES DE ENTORNO (.env.example)
# Copia este archivo como '.env' y completa con tus credenciales:
# cp .env.example .env
# =====================================================================

# 1. Inteligencia Artificial (LLM & STT)
OPENAI_API_KEY=
GROQ_API_KEY=
GEMINI_API_KEY=
AI_LLM_MODEL=gpt-4o-mini

# 2. Telefonía SIP VoIP (Troncal Zadarma)
ZADARMA_SIP_SERVER=sip.zadarma.com
ZADARMA_SIP_USER=
ZADARMA_SIP_PASSWORD=
ZADARMA_PHONE_NUMBER=+523385261250

# 3. Despacho y Notificaciones (Telegram Bot)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# 4. Parámetros de Voz y Transcripción
VOICE_NAME=es-MX-DaliaNeural
WHISPER_MODEL=base
WHISPER_COMPUTE_TYPE=int8
WHISPER_THREADS=4
PORT=5060

# 5. Base de Datos de Grafos (PostgreSQL + Apache AGE)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=ryu_db
POSTGRES_USER=ryu_admin
POSTGRES_PASSWORD=

# 6. Integración POS Soft Restaurant (Agente Local)
SOFTRESTAURANT_SERVER=localhost\SOFTRESTAURANT
SOFTRESTAURANT_DATABASE=SOFTRESTAURANT10
SOFTRESTAURANT_USER=sa
SOFTRESTAURANT_PASSWORD=
SOFTRESTAURANT_DRIVER=ODBC Driver 17 for SQL Server
SOFTRESTAURANT_ENABLE_INJECTION=false
POS_BRIDGE_SECRET=
RYU_VPS_URL=http://127.0.0.1:8000
POS_POLL_INTERVAL_SEC=3.5

# 7. Panel de Control y Seguridad HMAC
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
ADMIN_SECRET_KEY=



