# =====================================================================
# RESTAURANTE RYU - PLANTILLA DE VARIABLES DE ENTORNO (.env.example)
# Copia este archivo como '.env' y completa con tus valores reales:
# cp .env.example .env
# =====================================================================

# 1. Inteligencia Artificial (OpenAI)
OPENAI_API_KEY=tu_openai_api_key_aqui
GROQ_API_KEY=tu_groq_api_key_opcional

# 2. Telefonía SIP (Zadarma)
ZADARMA_SIP_SERVER=sip.zadarma.com
ZADARMA_SIP_USER=tu_extension_zadarma_ej_20432
ZADARMA_SIP_PASSWORD=tu_contrasena_sip_zadarma
ZADARMA_PHONE_NUMBER=+523385261250

# 3. Notificaciones y Comandas en Tiempo Real (Telegram)
TELEGRAM_BOT_TOKEN=tu_telegram_bot_token_aqui
TELEGRAM_CHAT_ID=tu_telegram_chat_id_grupo_o_canal

# 4. Configuración del Servidor y Audio
VOICE_NAME=es-MX-DaliaNeural
WHISPER_MODEL=base
WHISPER_COMPUTE_TYPE=int8
WHISPER_THREADS=4
PORT=5060

# 5. Base de Datos de Grafos (PostgreSQL + Apache AGE)
POSTGRES_HOST=ryu-postgres-age
POSTGRES_PORT=5432
POSTGRES_DB=ryu_db
POSTGRES_USER=ryu_admin
POSTGRES_PASSWORD=ryu_secret_password_cambiar

# 6. Base de Datos Soft Restaurant (Microsoft SQL Server)
SOFTRESTAURANT_SERVER=localhost\SOFTRESTAURANT
SOFTRESTAURANT_DATABASE=SOFTRESTAURANT10
SOFTRESTAURANT_USER=sa
SOFTRESTAURANT_PASSWORD=tu_password_sql_server
SOFTRESTAURANT_DRIVER=ODBC Driver 17 for SQL Server
SOFTRESTAURANT_ENABLE_INJECTION=true


